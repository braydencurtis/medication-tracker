{
  "expo": {
    "name": "Penny's Meds",
    "slug": "penny-meds",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "pennymeds",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#7B4F9E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.personal.pennymeds"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7B4F9E"
      },
      "package": "com.personal.pennymeds",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#7B4F9E"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to upload pet pictures."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5b17bb52-8b24-4ff3-af48-a90f08f54d49"
      }
    },
    "owner": "code-pirates"
  }
}
